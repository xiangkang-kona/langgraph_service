# 环境变量样例：复制为 .env 并按需修改（.env 已被 .gitignore 排除，不入库）
# 本地 docker compose 会读取这些变量；部署到云平台时在平台的变量面板配置同名变量即可

# 数据库连接串（本地默认指向 compose 里的 db 服务）
DATABASE_URL=postgresql://support:support123@localhost:5432/support

# 百炼 DashScope API Key（LLM 与 Embedding 共用）
DASHSCOPE_API_KEY=你的百炼APIKey

# 接口鉴权 Key（演示默认值，生产请替换为随机串）
API_KEY=dev-api-key-0001

# 可选：服务监听地址与端口（本地开发默认 127.0.0.1:8000，容器内由 compose 覆盖为 0.0.0.0）
# SERVICE_HOST=127.0.0.1
# SERVICE_PORT=8000
